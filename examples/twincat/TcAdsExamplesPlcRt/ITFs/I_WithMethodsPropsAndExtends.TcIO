  <Itf Name="I_WithMethodsPropsAndExtends" Id="{7ddef0b9-681e-4d66-b951-df1d6c6fc727}">
    <Declaration><![CDATA[// Interface with inheritence, methods and properties.
INTERFACE I_WithMethodsPropsAndExtends EXTENDS __SYSTEM.IQueryInterface
]]></Declaration>
    <Method Name="FullMethod" Id="{bdac14fd-4503-477d-9291-7988a7499f62}">
      <Declaration><![CDATA[// A method with all types of input and outputs as well as a return type.
METHOD FullMethod : UDINT
VAR_INPUT
	InArg1  	: STRING(64);
	InArg2		: Tc2_System.ST_CpuCoreInfo; 
END_VAR
VAR_IN_OUT
	InOutArg1	: POINTER TO __UXINT;
END_VAR
VAR_OUTPUT
	OutArg1		: Tc2_System.E_SeekOrigin;
	OutArg2		: Tc2_System.T_MaxString;
END_VAR
]]></Declaration>
    </Method>
