<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <Itf Name="I_WithMethods" Id="{624f7d8a-68ae-46f4-9977-e90ce31e398c}">
    <Declaration><![CDATA[// Interface with only methods
INTERFACE I_WithMethods
]]></Declaration>
    <Method Name="FullMethod" Id="{4725202e-02cb-4d33-a9b1-b25623e995df}">
      <Declaration><![CDATA[// A method with all types of input and outputs as well as a return type.
METHOD FullMethod : UDINT
VAR_INPUT
	InArg1  	: STRING(64);
	InArg2		: Tc2_System.ST_AmsAddr; 
END_VAR
VAR_IN_OUT
	InOutArg1	: POINTER TO __UXINT;
END_VAR
VAR_OUTPUT
	OutArg1		: Tc2_System.E_SeekOrigin;
	OutArg2		: Tc2_System.T_MaxString;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="ReturnOnlyMethod" Id="{e4745652-e289-4efb-9ba6-ea8a023b1f6d}">
      <Declaration><![CDATA[// A method with only a return type an no args.
METHOD ReturnOnlyMethod : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
    </Method>
    <Method Name="VoidMethod" Id="{7c944a3f-5617-41b9-bc01-469710e90a05}">
      <Declaration><![CDATA[// A method that has no arguments.
METHOD VoidMethod
VAR_INPUT
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>